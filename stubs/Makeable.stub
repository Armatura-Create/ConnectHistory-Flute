<?php

namespace Flute\Core\Traits;

/**
 * Заглушка типов для статического анализа. На выполнение не влияет.
 *
 * В самой Flute метод объявлен как `make(): self`, а в трейте `self` резолвится
 * в класс, который трейт использует, — то есть в Field. Поэтому Button::make()
 * и Tab::make() статически имеют тип Field, и вся цепочка после них не проверяется:
 * ни существование методов, ни ТИПЫ АРГУМЕНТОВ.
 *
 * Именно так проехала ошибка `Button::href(UrlSupport)` вместо string — она нашлась
 * только в проде. Здесь тот же метод объявлен как `static`, и анализатор снова
 * видит настоящий класс.
 */
trait Makeable
{
    /**
     * @return static
     */
    public static function make(?string $name = null): static
    {
    }
}
